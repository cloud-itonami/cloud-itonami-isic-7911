{:paths ["src"]
 :deps {
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}

        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langgraph"}
        ;; the settlement amount is recomputed from the booking's own
        ;; filed rate plan rather than read out of the advisor's proposal.
        ;; kotoba.reservation is integer-only so that recompute is exact.
        io.github.kotoba-lang/reservation
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.reservation"}
        ;; A travel agency is an INTERMEDIARY: it shops third-party
        ;; inventory rather than selling its own. `reservation` prices one
        ;; operator's own rate plan and cannot answer "which flights
        ;; actually connect" or "was that really the cheapest". These two
        ;; do, and the governor re-runs both rather than restating the
        ;; advisor -- see `fare-search-violations` (ADR-2608039960).
        io.github.kotoba-lang/itinerary
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.itinerary"}
        io.github.kotoba-lang/fare
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.fare"}
        ;; Build-time only: the operator-console renderer streams the
        ;; vendored デジタル庁デザインシステム stylesheet into the page.
        ;; Base design system for this workspace (AGENTS.md, 2026-08-05).
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
:dev {:override-deps
        {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
         io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchain"}
         io.github.kotoba-lang/itinerary
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.itinerary"}
         io.github.kotoba-lang/fare
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.fare"}}}
  :run {:main-opts ["-m" "travelagency.sim"]}
  ;; kbb -M:dev:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by driving the
  ;;      REAL actor graph. Throws if the run produces 0 HARD governor
  ;;      holds (flagship checklist item 2).
  :render-html {:main-opts ["-m" "travelagency.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
