{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "98045c7ad26c71c3505cb8fefdcbe0dcdf98f925"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}
        ;; the settlement amount is recomputed from the booking's own
        ;; filed rate plan rather than read out of the advisor's proposal.
        ;; kotoba.reservation is integer-only so that recompute is exact.
        io.github.kotoba-lang/reservation
        {:git/sha "c27ee70434be8db34390f7de12e8294a15dac100"}
        ;; A travel agency is an INTERMEDIARY: it shops third-party
        ;; inventory rather than selling its own. `reservation` prices one
        ;; operator's own rate plan and cannot answer "which flights
        ;; actually connect" or "was that really the cheapest". These two
        ;; do, and the governor re-runs both rather than restating the
        ;; advisor -- see `fare-search-violations` (ADR-2608039960).
        io.github.kotoba-lang/itinerary
        {:git/sha "ede40969df1076e244393dfaaa5460bcf84df526"}
        io.github.kotoba-lang/fare
        {:git/sha "2d41bfbc5cce903d4ad93a1e1b8543008e9f6541"}
        ;; Build-time only: the operator-console renderer streams the
        ;; vendored デジタル庁デザインシステム stylesheet into the page.
        ;; Base design system for this workspace (CLAUDE.md, 2026-08-05).
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/itinerary
         {:local/root "../../kotoba-lang/itinerary"}
         io.github.kotoba-lang/fare
         {:local/root "../../kotoba-lang/fare"}}}
  :run {:main-opts ["-m" "travelagency.sim"]}
  ;; kbb -M:dev:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by driving the
  ;;      REAL actor graph. Throws if the run produces 0 HARD governor
  ;;      holds (flagship checklist item 2).
  :render-html {:main-opts ["-m" "travelagency.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
