(ns travelagency.advisor-test
  "Unit tests of `travelagency.advisor` proposal generation."
  (:require [kotoba.test :refer [deftest is testing]]
            [travelagency.advisor :as adv]
            [travelagency.store :as store]))

(def db (store/seed-db))

(deftest propose-booking-record-shape
  (testing "booking-record proposal has correct shape and fields"
    (let [p (adv/infer db {:op :log-booking-record
                           :booking-id "bkg-1"
                           :patch {:traveler "Tanaka" :status "booked"}})]
      (is (= :log-booking-record (:op p)))
      (is (= "bkg-1" (:booking-id p)))
      (is (= :propose (:effect p)))
      (is (<= 0 (:confidence p) 1))
      (is (map? (:value p)))
      (is (contains? (:value p) :booking-id)))))

(deftest propose-booking-operation-shape
  (testing "booking-operation proposal has correct shape"
    (let [p (adv/infer db {:op :schedule-booking-operation
                           :booking-id "bkg-2"
                           :patch {:item "itinerary segment reconfirmation" :urgency "routine"}})]
      (is (= :schedule-booking-operation (:op p)))
      (is (= "bkg-2" (:booking-id p)))
      (is (= :propose (:effect p))))))

(deftest propose-vendor-settlement-shape
  (testing "vendor-settlement proposal has correct shape"
    (let [p (adv/infer db {:op :coordinate-vendor-settlement
                           :booking-id "bkg-1"
                           :patch {:item "hotel settlement" :estimated-amount 1200}})]
      (is (= :coordinate-vendor-settlement (:op p)))
      (is (= :propose (:effect p)))
      (is (string? (:summary p))))))

(deftest propose-transaction-concern-shape
  (testing "transaction-concern proposal always proposes, never actuates"
    (let [p (adv/infer db {:op :flag-transaction-concern
                           :booking-id "bkg-1"
                           :patch {:concern "possible duplicate charge reported for bkg-1"}})]
      (is (= :flag-transaction-concern (:op p)))
      (is (= :propose (:effect p)))
      (is (string? (:summary p))))))

(deftest all-proposals-effect-is-always-propose
  (testing "every proposal type has :effect :propose, never direct actuation"
    (doseq [op [:log-booking-record :schedule-booking-operation
                :coordinate-vendor-settlement :flag-transaction-concern]]
      (let [p (adv/infer db {:op op :booking-id "bkg-1" :patch {}})]
        (is (= :propose (:effect p))
            (str "op " op " must have :effect :propose"))))))

(deftest rationale-string-is-present
  (testing "every proposal has a rationale explaining the advisor's thinking"
    (doseq [op [:log-booking-record :schedule-booking-operation
                :coordinate-vendor-settlement :flag-transaction-concern]]
      (let [p (adv/infer db {:op op :booking-id "bkg-1" :patch {}})]
        (is (string? (:rationale p))
            (str "op " op " must have a :rationale string"))))))

(deftest unknown-op-returns-empty-proposal
  (testing "an op outside the four-op set produces an unrecognized (empty) proposal shape, left for the governor to reject"
    (let [p (adv/infer db {:op :not-a-real-op :booking-id "bkg-1" :patch {}})]
      (is (empty? p)))))
